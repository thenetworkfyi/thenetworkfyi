# Copy to .env and fill in. .env is gitignored.

# --- Database ---
# Parts, not a single DATABASE_URL: the app builds (and percent-encodes) the
# connection URI itself, so POSTGRES_PASSWORD can be a literal password with
# no manual URL-encoding. Local/manual runs use POSTGRES_HOST=localhost; under
# docker compose the worker overrides it to `db` (see docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=network_db
POSTGRES_USER=network
POSTGRES_PASSWORD=change-me

# --- Container image (production) ---
# IMAGE=ghcr.io/<owner>/thenetwork-agent:latest

# --- LLM (provider chosen by the model string prefix) ---
AGENT_MODEL=anthropic:claude-sonnet-5
# Cheaper/smaller model used for fixed-prompt LLM subtasks that don't need the
# main agent model (memory sanitization and the hourly abuse judge).
SMALL_AGENT_MODEL=anthropic:claude-haiku-4-5
EMBED_MODEL=text-embedding-3-small
AGENT_API_KEY=
SMALL_AGENT_API_KEY=
EMBED_API_KEY=

# Test-only: LLM-as-judge model for tests/scenarios/test_live_archetypes.py
# and sim/scoring/scoring.py's build_transcript_judge. Kept separate from
# AGENT_MODEL so a judge call is never an implicit third-party default -
# those call sites skip/fail rather than falling back to pydantic_evals'
# own default (openai:gpt-5.2) when this is unset.
TEST_LLM_JUDGE_MODEL=
TEST_LLM_JUDGE_API_KEY=

# --- Mailbox ---
# IMAP (polled for inbound) and SMTP (used to send replies) are separate
# accounts/credentials, potentially on different providers entirely.
IMAP_ACCOUNT=agent@example.com
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Optional separate inbox for relay-domain catch-all mail. Both values must be
# set together; the relay inbox uses IMAP_HOST and IMAP_PORT above.
RELAY_IMAP_ACCOUNT=
RELAY_IMAP_PASSWORD=
SMTP_ACCOUNT=agent@example.com
SMTP_PASSWORD=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_FROM=agent@example.com
# Existing Dovecot catch-all domain used for hidden introduction reply addresses.
# Deliver *@this-domain into RELAY_IMAP_ACCOUNT when configured, otherwise
# IMAP_ACCOUNT, and authorize SES/SMTP to send from it.
RELAY_DOMAIN=relay.example.com
# With this enabled, relay mail is accepted only when the third-party IMAP provider
# supplies a passing result in the first Authentication-Results header. See
# docs/email-relay-setup.md.
REQUIRE_SENDER_AUTH=true

# --- Tuning ---
WORKER_CONCURRENCY=4
RATE_LIMIT_PER_HOUR=20
UNAUTHENTICATED_RATE_LIMIT_PER_HOUR=6
GLOBAL_EMAIL_RATE_LIMIT_PER_HOUR=200
DISPATCH_MAX_SENDS_PER_RUN=12
DISPATCH_RECIPIENT_DAILY_CAP=12
DISPATCH_SENDER_REPLY_DAILY_CAP=12
REGISTRATION_LIMIT_PER_DAY=100
INTRODUCTION_MAX_PROPOSALS_PER_RUN=6
INTRODUCTION_MAX_OUTSTANDING_REQUESTS_PER_PERSON=6
INTRODUCTION_MAX_REQUESTS_PER_PERSON_IN_WINDOW=6
# The scanner dependencies are always installed; this controls model loading.
CONTENT_SCAN_ENABLED=false
# Required only for the first enabled startup when the gated Prompt Guard 2
# model is not yet in the persistent Hugging Face cache. Accept the model's
# Llama 4 Community License on Hugging Face before supplying this token.
HF_TOKEN=
SANITIZE_LLM_TIER_ENABLED=true

# Server-side secret used to derive non-reversible sender pseudonyms for
# PII-safe audit correlation. Generate a long random value and keep it stable
# for as long as audit correlation continuity matters.
SENDER_IDENTIFIER_SECRET=dev
# Opt-in primary-inbox protection. This rejects disposable domains, records
# keyed fingerprints for ordinary primary mail, pauses on a 25-sender/hour
# burst, and enables the hourly fixed-policy cross-account judge. A non-empty
# SENDER_IDENTIFIER_SECRET is required. Relay mail is outside this control.
PRIMARY_INTAKE_BURST_MONITORING_ENABLED=false

# Optional HMAC key for stable opaque replacements in redacted model-response
# logs. Leave unset to redact without correlating repeated tokens, URLs,
# secrets, or application identifiers. Do not reuse SENDER_IDENTIFIER_SECRET.
RESPONSE_LOG_REDACTION_SECRET=

# --- Admin channel (see docs/security.md, thenetwork/admin/auth.py) ---
# JSON array of allowlisted admin sender addresses.
ADMIN_EMAILS=["admin@example.com"]
# Armored PGP public key of the trusted admin signer. Admin requests must be
# multipart/signed (PGP/MIME, RFC 3156) with a detached signature verifying
# against this key. Paste the full "-----BEGIN PGP PUBLIC KEY BLOCK-----" ...
# "-----END PGP PUBLIC KEY BLOCK-----" block, escaping newlines as \n.
ADMIN_GPG_PUBLIC_KEY=
ADMIN_REPLAY_WINDOW_SECONDS=300

# --- OpenTelemetry Collector ---
# Target OTLP endpoint (e.g. gRPC/HTTP endpoint for log export) and optional authentication header value.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=

