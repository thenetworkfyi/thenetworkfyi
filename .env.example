# Copy to .env and fill in. .env is gitignored.

# --- Database ---
# Local/manual runs use localhost; under docker compose the worker overrides the
# host to `db` automatically (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://network:network@localhost:5432/network_db
# Used by the db service (and the compose-injected worker DATABASE_URL).
POSTGRES_USER=network
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Container image (production) ---
# IMAGE=ghcr.io/<owner>/thenetwork-agent:latest

# --- LLM (provider chosen by the model string prefix) ---
AGENT_MODEL=anthropic:claude-sonnet-4-6
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Mailbox ---
EMAIL_ACCOUNT=agent@example.com
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Tuning ---
WORKER_CONCURRENCY=4
RATE_LIMIT_PER_HOUR=10
CONTENT_SCAN_ENABLED=false
SANITIZE_LLM_TIER_ENABLED=false
